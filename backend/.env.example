# LOGISENSE WMS — Configurações de Ambiente (Modelo .env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.

# Porta do servidor HTTP
PORT=3001

# Ambiente de execução (development | production | test)
NODE_ENV=development

# Conexão com o Banco de Dados (SQLite local para desenvolvimento acadêmico PIM III)
DATABASE_URL="file:./dev.db"

# Segredo para assinatura dos tokens JWT (utilizar chave forte em produção)
JWT_SECRET="logisense-secret-key-pim-iii-2026-secure"

# Tempo de expiração do token JWT
JWT_EXPIRES_IN="8h"

# Origem autorizada para CORS (endereço do frontend Vite/React)
CORS_ORIGIN="http://localhost:5173"
