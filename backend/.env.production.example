# LOGISENSE WMS — Variáveis de Ambiente de Produção (Modelo)
# Preencher no Render / Vercel conforme o ambiente

# Porta da aplicação (definida automaticamente pelo Render)
PORT=3001

# Ambiente de execução
NODE_ENV=production

# Conexão com o Banco de Dados PostgreSQL (Supabase com Pooler ou Neon)
# Exemplo Supabase (Pooler com SSL):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DATABASE_URL=""

# Chave criptográfica segura para geração de tokens JWT em produção (64 caracteres)
JWT_SECRET=""

# Tempo de expiração do token JWT
JWT_EXPIRES_IN="8h"

# Origem autorizada no CORS (URL do frontend publicado na Vercel)
# Exemplo: CORS_ORIGIN="https://logisense-wms.vercel.app"
CORS_ORIGIN=""
