datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// DIRETRIZES DE PRIVACIDADE E PROTEÇÃO DE DADOS (LGPD - LEI Nº 13.709/2018)
// Implementação acadêmica para demonstração no PIM III:
// 1. Princípio da Necessidade e Minimização (Art. 6º, III):
//    O modelo User coleta apenas o estritamente necessário para identificação no WMS:
//    nome, e-mail corporativo, perfil funcional (RBAC) e departamento.
//    Não são coletados dados pessoais sensíveis, CPF, RG, endereço residencial ou dados financeiros.
// 2. Princípio da Segurança (Art. 6º, VII):
//    Credenciais são armazenadas exclusivamente na forma de hash criptográfico (bcryptjs).
// 3. Princípio da Responsabilização e Transparência:
//    Logs de auditoria registram ações operacionais sem expor senhas ou tokens.
// (Nota acadêmica: projeto de boas práticas de segurança da informação no escopo do PIM III).
// ==============================================================================

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  role         String          @default("OPERADOR") // ADMIN, GERENTE, OPERADOR, CONSULTA
  department   String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]
  auditLogs    AuditLog[]
  receivings   Receiving[]
  orders       Order[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]

  @@map("categories")
}

model Location {
  id             String          @id @default(uuid())
  code           String          @unique // Ex: A-01-01
  aisle          String // Corredor (ex: A, B)
  rack           String // Estante (ex: 01, 02)
  shelf          String // Posicao (ex: 01, 02)
  capacity       Int             @default(100)
  status         String          @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  createdAt      DateTime        @default(now())
  products       Product[]
  receivingItems ReceivingItem[]
  orderItems     OrderItem[]

  @@map("locations")
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  description    String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  unit           String          @default("UN") // UN, CX, KG, LT, PC
  weight         Float?          // Peso em kg
  dimensions     String?         // Ex: 30x20x15 cm
  minStock       Int             @default(10)
  currentStock   Int             @default(0)
  locationId     String?
  location       Location?       @relation(fields: [locationId], references: [id])
  status         String          @default("ACTIVE") // ACTIVE, INACTIVE, DISCONTINUED
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  movements      StockMovement[]
  orderItems     OrderItem[]
  receivingItems ReceivingItem[]

  @@map("products")
}

model StockMovement {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String   // ENTRY, EXIT, ADJUSTMENT, TRANSFER
  quantity    Int
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  origin      String?  // Ex: "Fornecedor Alpha", "A-01-01"
  destination String?  // Ex: "A-01-01", "Cliente Beta"
  notes       String?
  createdAt   DateTime @default(now())

  @@map("stock_movements")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique // Ex: PED-2026-001
  customerName String      @default("") // Nome do cliente / destinatário
  customer     String?     // Compatibilidade com seed anterior
  status       String      @default("PENDING") // PENDING, PICKING, PICKED, SHIPPED, CANCELLED
  notes        String?
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  pickedAt     DateTime?
  pickedBy     String?
  shippedAt    DateTime?
  shippedBy    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                String    @id @default(uuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  requestedQuantity Int       @default(1)
  pickedQuantity    Int       @default(0)
  quantity          Int?      @default(0) // Compatibilidade
  price             Float?    @default(0.0) // Compatibilidade
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now())

  @@map("order_items")
}

model Receiving {
  id              String          @id @default(uuid())
  receivingNumber String          @unique // Ex: REC-2026-001
  supplier        String
  status          String          @default("PENDING") // PENDING, CHECKING, CHECKED, STORED, CANCELLED
  notes           String?
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  checkedAt       DateTime?
  checkedBy       String?
  storedAt        DateTime?
  storedBy        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           ReceivingItem[]

  @@map("receivings")
}

model ReceivingItem {
  id               String    @id @default(uuid())
  receivingId      String
  receiving        Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  expectedQuantity Int
  receivedQuantity Int       @default(0)
  locationId       String?
  location         Location? @relation(fields: [locationId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("receiving_items")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, STOCK_ENTRY, STOCK_EXIT, RECEIVING_CREATE, RECEIVING_CHECK, RECEIVING_STORE, RECEIVING_CANCEL, ORDER_CREATE, ORDER_PICKING_START, ORDER_PICK, ORDER_SHIPPED, ORDER_CANCELLED
  module      String   // AUTH, PRODUCTS, STOCK, ORDERS, USERS, IOT, RECEIVING
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model IoTReading {
  id          String   @id @default(uuid())
  area        String   // Área A, Área B, Área C
  temperature Float
  humidity    Float
  status      String   @default("NORMAL") // NORMAL, WARNING, CRITICAL
  timestamp   DateTime @default(now())
  isSimulated Boolean  @default(true)

  @@map("iot_readings")
}

model Alert {
  id             String    @id @default(uuid())
  title          String
  message        String
  severity       String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  module         String    @default("IOT")    // STOCK, IOT, ORDER, SYSTEM
  area           String?   // Área A, Área B, Área C
  type           String?   // TEMPERATURA, UMIDADE
  detectedValue  Float?
  limitValue     Float?
  status         String    @default("OPEN")   // OPEN, RESOLVED
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedUserId String?
  createdAt      DateTime  @default(now())

  @@map("alerts")
}

